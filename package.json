{
  "name": "lan-hongtao-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run images:generate",
    "dev": "vite",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "prebuild": "npm run images:generate",
    "build": "tsc -b && vite build && node scripts/generate-offline-manifest.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:presentation": "node --experimental-strip-types --test scripts/presentation.test.mjs",
    "check": "npm run lint && npm run test:presentation && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.35.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.16"
  }
}
